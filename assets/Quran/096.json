{
  "1": "اِقْرَأْ بِاسْمِ رَبِّكَ الَّذ۪ي خَلَقَۚ",
  "2": "خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍۚ",
  "3": "اِقْرَأْ وَرَبُّكَ الْاَكْرَمُۙ",
  "4": "اَلَّذ۪ي عَلَّمَ بِالْقَلَمِۙ",
  "5": "عَلَّمَ الْاِنْسَانَ مَا لَمْ يَعْلَمْۜ",
  "6": "كَلَّٓا اِنَّ الْاِنْسَانَ لَيَطْغٰىۙ",
  "7": "اَنْ رَاٰهُ اسْتَغْنٰىۜ",
  "8": "اِنَّ اِلٰى رَبِّكَ الرُّجْعٰىۜ",
  "9": "اَرَاَيْتَ الَّذ۪ي يَنْهٰىۙ",
  "10": "عَبْداً اِذَا صَلّٰىۜ",
  "11": "اَرَاَيْتَ اِنْ كَانَ عَلَى الْهُدٰىۙ",
  "12": "اَوْ اَمَرَ بِالتَّقْوٰىۜ",
  "13": "اَرَاَيْتَ اِنْ كَذَّبَ وَتَوَلّٰىۜ",
  "14": "اَلَمْ يَعْلَمْ بِاَنَّ اللّٰهَ يَرٰىۜ",
  "15": "كَلَّا لَئِنْ لَمْ يَنْتَهِ۬ لَنَسْفَعاً بِالنَّاصِيَةِۙ",
  "16": "نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍۚ",
  "17": "فَلْيَدْعُ نَادِيَهُۙ",
  "18": "سَنَدْعُ الزَّبَانِيَةَۙ",
  "19": "كَلَّاۜ  لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ"
}