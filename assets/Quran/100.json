{
  "1": "وَالْعَـادِيَاتِ ضَبْـحاًۙ",
  "2": "فَالْمُـورِيَاتِ قَـدْحاًۙ",
  "3": "فَالْمُغ۪يرَاتِ صُبْحاًۙ",
  "4": "فَاَثَرْنَ بِه۪ نَقْعاًۙ",
  "5": "فَوَسَطْنَ بِه۪ جَمْعاًۙ",
  "6": "اِنَّ الْاِنْسَانَ لِرَبِّه۪ لَكَنُودٌۚ",
  "7": "وَاِنَّهُ عَلٰى ذٰلِكَ لَشَه۪يدٌۚ",
  "8": "وَاِنَّهُ لِحُبِّ الْخَيْرِ لَشَد۪يدٌۜ",
  "9": "اَفَلَا يَعْلَمُ اِذَا بُعْثِرَ مَا فِي الْقُبُورِۙ",
  "10": "وَحُصِّلَ مَا فِي الصُّدُورِۙ",
  "11": "اِنَّ رَبَّهُمْ بِهِمْ يَوْمَئِذٍ لَخَب۪يرٌ"
}