{
  "1": "اِذَا السَّمَٓاءُ انْفَطَرَتْۙ",
  "2": "وَاِذَا الْـكَوَاكِبُ انْتَثَرَتْۙ",
  "3": "وَاِذَا الْبِحَارُ فُجِّرَتْۙ",
  "4": "وَاِذَا الْقُبُورُ بُعْثِرَتْۙ",
  "5": "عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَاَخَّرَتْۜ",
  "6": "يَٓا اَيُّهَا الْاِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْـكَر۪يمِۙ",
  "7": "اَلَّذ۪ي خَلَقَكَ فَسَوّٰيكَ فَعَدَلَكَۙ",
  "8": "ف۪ٓي اَيِّ صُورَةٍ مَا شَٓاءَ رَكَّبَكَۜ",
  "9": "كَلَّا بَلْ تُكَذِّبُونَ بِالدّ۪ينِۙ",
  "10": "وَاِنَّ عَلَيْكُمْ لَحَافِظ۪ينَۙ",
  "11": "كِرَاماً كَاتِب۪ينَۙ",
  "12": "يَعْلَمُونَ مَا تَفْعَلُونَ",
  "13": "اِنَّ الْاَبْرَارَ لَف۪ي نَع۪يمٍۚ",
  "14": "وَاِنَّ الْفُجَّارَ لَف۪ي جَح۪يمٍۚ",
  "15": "يَصْلَوْنَهَا يَوْمَ الدّ۪ينِ",
  "16": "وَمَا هُمْ عَنْهَا بِغَٓائِب۪ينَۜ",
  "17": "وَمَٓا اَدْرٰيكَ مَا يَوْمُ الدّ۪ينِۙ",
  "18": "ثُمَّ مَٓا اَدْرٰيكَ مَا يَوْمُ الدّ۪ينِۜ",
  "19": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَيْـٔاًۜ وَالْاَمْرُ يَوْمَئِذٍ لِلّٰهِ"
}