{
  "1": "سَبِّحِ اسْمَ رَبِّكَ الْاَعْلٰىۙ",
  "2": "اَلَّذ۪ي خَلَقَ فَسَوّٰىۙۖ",
  "3": "وَالَّذ۪ي قَدَّرَ فَهَدٰىۙۖ",
  "4": "وَالَّـذ۪ٓي اَخْرَجَ الْمَرْعٰىۙۖ",
  "5": "فَجَعَلَهُ غُثَٓاءً اَحْوٰىۜ",
  "6": "سَنُقْرِئُكَ فَلَا تَنْسٰىۙ",
  "7": "اِلَّا مَا شَٓاءَ اللّٰهُۜ  اِنَّهُ يَعْلَمُ الْجَهْرَ وَمَا يَخْفٰىۜ",
  "8": "وَنُيَسِّرُكَ لِلْيُسْرٰىۚ",
  "9": "فَذَكِّرْ اِنْ نَفَعَتِ الذِّكْرٰىۜ",
  "10": "سَيَذَّكَّرُ مَنْ يَخْشٰىۙ",
  "11": "وَيَتَجَنَّبُهَا الْاَشْقٰىۙ",
  "12": "اَلَّذ۪ي يَصْلَى النَّارَ الْـكُبْرٰىۚ",
  "13": "ثُمَّ لَا يَمُوتُ ف۪يهَا وَلَا يَحْيٰىۜ",
  "14": "قَدْ اَفْلَحَ مَنْ تَزَكّٰىۙ",
  "15": "وَذَكَرَ اسْمَ رَبِّه۪ فَصَلّٰىۜ",
  "16": "بَلْ تُؤْثِرُونَ الْحَيٰوةَ الدُّنْيَاۘ",
  "17": "وَالْاٰخِرَةُ خَيْرٌ وَاَبْـقٰىۜ",
  "18": "اِنَّ هٰذَا لَفِي الصُّحُفِ الْاُو۫لٰىۙ",
  "19": "صُحُفِ اِبْرٰه۪يمَ وَمُوسٰى"
}